# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local render/smoke output
scratch/
# A working file at the root of a repo whose .env.local rule is absolute must
# not be able to ride along on a wildcard `git add -A`. Three did sit here
# untracked and unmatched (scratch-sb.ts, scratch-seams-render.tsx,
# scratch-weekly.tsx); `scratch/` only ever matched the directory.
scratch-*

# Agent worktrees (Claude Code --isolation worktree)
.claude/worktrees/

# graphify knowledge graph (local tool output; rebuildable)
graphify-out/
